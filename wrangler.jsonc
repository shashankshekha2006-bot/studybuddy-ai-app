{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studybuddy-ai",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
